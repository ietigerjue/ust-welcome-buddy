# UST Buddy environment template
# Copy this file to .env.local for local development.
# Never commit .env.local or real secret values.

# App
RAG_DEBUG=false

# Admin
ADMIN_IMPORT_TOKEN=replace_with_admin_token

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
MODEL_SECRET_ENCRYPTION_KEY=replace_with_32_byte_base64_or_hex_key

# Chat LLM
LLM_PROVIDER=minimax
MINIMAX_API_KEY=replace_with_minimax_api_key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=replace_with_chat_model

# Optional DeepSeek-compatible Chat / Metadata LLM
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Metadata LLM
METADATA_LLM_PROVIDER=minimax

# Image Parser / VLM
IMAGE_PARSE_PROVIDER=minimax_vlm
MINIMAX_VLM_API_KEY=replace_with_minimax_vlm_api_key
MINIMAX_VLM_BASE_URL=https://api.minimaxi.com
MINIMAX_VLM_ENDPOINT=/v1/coding_plan/vlm

# Embedding
EMBEDDING_PROVIDER=jina
EMBEDDING_API_KEY=replace_with_embedding_api_key
EMBEDDING_BASE_URL=https://api.jina.ai/v1
EMBEDDING_MODEL=jina-embeddings-v3
EMBEDDING_DIMENSIONS=1024
SEMANTIC_DUPLICATE_THRESHOLD=0.82

# Proxy / Network
HTTPS_PROXY=
HTTP_PROXY=

# Optional Future Providers
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
